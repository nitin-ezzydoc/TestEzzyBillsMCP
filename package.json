{
  "name": "ezzybills-mcp",
  "version": "1.3.0",
  "description": "Read-only MCP developer specification for generating EzzyBills applications",
  "main": "dist/http.js",
  "scripts": {
    "dev": "tsx src/http.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/http.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "ezzybills",
    "code-generation",
    "developer-api"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
